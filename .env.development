# .env.development
# Loaded by Vite when `mode === 'development'` (i.e. `npm run dev`/`dev:all`).
# Precedence: .env → .env.development → .env.local (last wins).
# Use .env.local for per-developer overrides (e.g. ngrok tunnels) — that file
# is git-ignored, while this one is committed and shared.

# ── Cross-app subdomain hosts (point each app at its localhost dev server) ──
# Without these, the prod-domain fallbacks in packages/constants/src/urls.ts
# kick in and cross-app links jump out of localhost.
VITE_LANDING_URL=http://localhost:5174
VITE_PORTAL_URL=http://localhost:5175
VITE_ADMIN_URL=http://localhost:5176

# Note: VITE_APP_ENV is intentionally NOT set here. detectAppEnv() in
# @s-class/config returns 'local' whenever import.meta.env.DEV is true,
# so the var only matters for built/deployed environments (staging/prod).

# ── Content-protection toggles (off in dev for easier debugging) ─────────────
VITE_CONTENT_PROTECTION_ENABLED=false
VITE_PROTECTION_WATERMARK=false
VITE_PROTECTION_BLOCK_DEVTOOLS=false
VITE_PROTECTION_DETECT_CAPTURE=false
